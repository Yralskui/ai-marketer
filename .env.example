# Скопируйте этот файл в .env и заполните. Файл .env НЕ коммитится.
# Пустое значение = значение по умолчанию из app/config.py.

# ===== Telegram =====
# Токен бота. Получить: написать @BotFather -> /newbot -> скопировать токен.
BOT_TOKEN=
# Telegram ID администраторов (поставщик услуги) через запятую: они создают компании и
# видят все. Клиенты сюда не вписываются — они входят по ссылке-приглашению (/invite).
# Узнать свой ID: написать боту @userinfobot (или запустить нашего бота — он ответит вашим ID).
ALLOWED_USER_IDS=
# Канал первой компании администратора: @username публичного канала или ID вида -100XXXXXXXXXX.
# Берётся один раз при создании этой компании; дальше канал любой компании меняется командой
# /channel прямо в боте. Бот должен быть администратором канала с правом публиковать сообщения.
TELEGRAM_CHANNEL_ID=
# Прокси для Telegram, если api.telegram.org недоступен (например, VPS в России):
# socks5://user:pass@host:port или http://user:pass@host:port. Пусто — напрямую.
TELEGRAM_PROXY=

# ===== LLM =====
# mock — детерминированная заглушка без интернета и ключей; openai — любой OpenAI-совместимый API.
LLM_PROVIDER=mock
# Адрес OpenAI-совместимого API. Для OpenAI: https://api.openai.com/v1
LLM_BASE_URL=
# Ключ API (platform.openai.com -> API keys, или ключ совместимого сервиса).
LLM_API_KEY=
# Модель, например gpt-4o-mini.
LLM_MODEL=
# Таймаут одного запроса к LLM в секундах и число повторов при сетевых ошибках.
LLM_TIMEOUT=
LLM_MAX_RETRIES=

# ===== Изображения =====
# mock — картинка-заглушка (Pillow) с темой поста. Реальные провайдеры — TODO (поток A).
IMAGE_PROVIDER=mock
# Ключ сервиса генерации изображений (когда появится реальный провайдер).
IMAGE_API_KEY=

# ===== Учёт расходов =====
# Цены в рублях для подсчёта расходов по компаниям (/costs). Mock-провайдеры считаются бесплатными.
# По умолчанию — примерно gpt-4o-mini (за 1 млн токенов) и одна картинка; поправьте под свой тариф.
LLM_PRICE_INPUT_PER_1M=15
LLM_PRICE_OUTPUT_PER_1M=60
IMAGE_PRICE=4

# ===== Хранилище =====
# URL базы SQLAlchemy. Пусто = SQLite-файл data/app.db.
# Пример: sqlite+aiosqlite:///data/app.db
DATABASE_URL=

# ===== Поведение =====
# Часовой пояс для расписания и разбора дат («завтра в 10 утра»).
TIMEZONE=Asia/Yekaterinburg
# true — публикатор ничего не отправляет в соцсети, только пишет в лог («как будто» опубликовал).
PUBLISH_DRY_RUN=true
# Автономная генерация черновиков по расписанию (пока заглушка).
ENABLE_AUTO_DRAFTS=false
# Еженедельный отчёт (пока заглушка).
ENABLE_WEEKLY_REPORT=false
# Как часто слать отчёт при ENABLE_WEEKLY_REPORT=true: 0 — по понедельникам в 10:00,
# число — каждые N минут (удобно показать автономную задачу на демо, например 5).
REPORT_INTERVAL_MINUTES=0
# Как часто планировщик проверяет посты к публикации, секунд.
PUBLISH_CHECK_INTERVAL_SECONDS=60
# Уровень логирования: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ===== Агент =====
# Максимум шагов «LLM -> инструмент» на одно сообщение и размер окна истории диалога.
AGENT_MAX_STEPS=6
AGENT_HISTORY_LIMIT=20
